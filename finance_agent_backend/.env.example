OPENAI_API_KEY=your_openai_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finance_agent_db
POSTGRES_PORT=5432
# If running inside Docker, host is 'postgres'. If running backend locally outside Docker, host is 'localhost'.
POSTGRES_HOST=postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/finance_agent_db

# Single Authorized Chat User Configuration
DEFAULT_USER_USERNAME=finance_user
DEFAULT_USER_EMAIL=user@financeagent.local
DEFAULT_USER_FULL_NAME=Finance User

# Valuation market assumptions (decimals). Rf is fetched live from ^TNX; these are fallbacks / house assumptions.
DEFAULT_RISK_FREE_RATE=0.042
DEFAULT_EQUITY_RISK_PREMIUM=0.044
EQUITY_RISK_PREMIUM_SOURCE=damodaran_implied_sp500_2026-07
DEFAULT_MARGINAL_TAX_RATE=0.25
DEFAULT_CREDIT_SPREAD=0.0125
