{# Verified Financial Auditor tables, shared by the synthesizer prompt context and the code-assembled report. #}
{% macro n(v, f="{:,.1f}") %}{{ f.format(v) if v is not none else "N/A" }}{% endmacro %}
{% macro row(label, items, attr, f="{:,.1f}") %}| {{ label }}{% if cite is defined %}{{ cite.row(attr, items) }}{% endif %} |{% for it in items %} {{ n(it[attr], f) }} |{% endfor %}{{ "\n" }}{% endmacro %}
{% macro fe(attr, year) %}{% if cite is defined %}{{ cite.field(attr, year) }}{% endif %}{% endmacro %}
{% macro header(items) %}| Metric |{% for it in items %} FY{{ it.fiscal_year }} |{% endfor %}{{ "\n" }}| :--- |{% for it in items %} ---: |{% endfor %}{{ "\n" }}{% endmacro %}

{% macro table_a(fa) %}{{ header(fa.multi_year_history) }}{{ row("Revenue", fa.multi_year_history, "revenue") }}{{ row("Revenue growth %", fa.multi_year_history, "revenue_growth_pct", "{:+.1f}%") }}{{ row("Gross margin %", fa.multi_year_history, "gross_margin_pct", "{:.2f}%") }}{{ row("Operating income", fa.multi_year_history, "operating_income") }}{{ row("Operating margin %", fa.multi_year_history, "operating_margin_pct", "{:.2f}%") }}{{ row("Net income (attrib.)", fa.multi_year_history, "net_income") }}{{ row("Net margin %", fa.multi_year_history, "net_margin_pct", "{:.2f}%") }}{{ row("Operating cash flow", fa.multi_year_history, "operating_cash_flow") }}{{ row("Capex", fa.multi_year_history, "capital_expenditures") }}{{ row("Free cash flow", fa.multi_year_history, "free_cash_flow") }}{{ row("FCF conversion %", fa.multi_year_history, "fcf_conversion_pct", "{:.1f}%") }}{{ row("Stock-based comp.", fa.earnings_quality, "stock_based_compensation") }}{{ row("SBC-adjusted FCF", fa.earnings_quality, "sbc_adjusted_fcf") }}{% endmacro %}

{% macro table_b(fa) %}{{ header(fa.earnings_quality) }}{{ row("Normalized operating income", fa.earnings_quality, "normalized_operating_income") }}{{ row("Normalized operating margin %", fa.earnings_quality, "normalized_operating_margin_pct", "{:.2f}%") }}{{ row("Normalized net income", fa.earnings_quality, "normalized_net_income") }}{{ row("Adjustments % of EBIT", fa.earnings_quality, "adjustments_pct_of_operating_income", "{:.1f}%") }}{{ row("Non-operating income", fa.earnings_quality, "non_operating_income") }}{{ row("Non-operating % of EBIT", fa.earnings_quality, "non_operating_to_operating_income_pct", "{:.1f}%") }}{{ row("Effective tax rate %", fa.earnings_quality, "effective_tax_rate_pct", "{:.1f}%") }}{{ row("Deferred tax % of NI", fa.earnings_quality, "deferred_tax_to_net_income_pct", "{:.1f}%") }}{{ row("Accruals (NI - OCF)", fa.earnings_quality, "accruals") }}{{ row("Sloan accruals ratio %", fa.earnings_quality, "sloan_accruals_ratio_pct", "{:.1f}%") }}{% endmacro %}

{% macro normalization_lines(fa) %}{% for y in fa.earnings_quality %}{% for adj in y.adjustments %}
- Normalization FY{{ adj.fiscal_year }}: {{ adj.label }} ({{ n(adj.amount) }}M, {{ adj.direction }}, affects {{ adj.affects }}) — {{ adj.rationale or "" }}
{% endfor %}{% endfor %}{% endmacro %}

{% macro table_c(fa) %}{{ header(fa.cost_structure) }}{{ row("Gross margin change (bps)", fa.cost_structure, "gross_margin_change_bps", "{:+,.0f}") }}{{ row("Operating margin change (bps)", fa.cost_structure, "operating_margin_change_bps", "{:+,.0f}") }}{{ row("Operating expenses ($M)", fa.cost_structure, "operating_expenses") }}{{ row("Opex growth %", fa.cost_structure, "operating_expense_growth_pct", "{:+.1f}%") }}{{ row("Opex growth - revenue growth (pp)", fa.cost_structure, "opex_growth_minus_revenue_growth_pp", "{:+.1f}") }}{{ row("DSO (days)", fa.working_capital, "dso_days") }}{{ row("DIO (days)", fa.working_capital, "dio_days") }}{{ row("DPO (days)", fa.working_capital, "dpo_days") }}{{ row("Cash conversion cycle (days)", fa.working_capital, "cash_conversion_cycle_days") }}{% endmacro %}

{% macro table_d(fa) %}{{ header(fa.capital_intensity) }}{{ row("Capex % of revenue", fa.capital_intensity, "capex_to_revenue_pct", "{:.1f}%") }}{{ row("Capex / D&A (x)", fa.capital_intensity, "capex_to_depreciation", "{:.2f}x") }}{{ row("Change in OCF", fa.capital_intensity, "ocf_change", "{:+,.1f}") }}{{ row("Change in capex", fa.capital_intensity, "capex_change", "{:+,.1f}") }}{{ row("Change in FCF", fa.capital_intensity, "fcf_change", "{:+,.1f}") }}{{ row("FCF change explained by capex %", fa.capital_intensity, "fcf_change_from_capex_pct", "{:.1f}%") }}{{ row("Diluted weighted shares (M)", fa.share_count_history, "diluted_weighted_shares") }}{{ row("Period-end shares (M)", fa.share_count_history, "period_end_shares_outstanding") }}{{ row("Period-end share growth %", fa.share_count_history, "period_end_share_growth_pct", "{:+.2f}%") }}{% endmacro %}

{% macro table_e(fa) %}{% set bs = fa.balance_sheet %}{% set pr = fa.profitability_and_return_ratios %}{% set sv = fa.solvency_and_liquidity_ratios %}
| Metric | Value |
| :--- | ---: |
| Cash & equivalents{{ fe("cash_and_equivalents", bs.fiscal_year) }} | ${{ n(bs.cash_and_equivalents) }}M |
| Marketable securities{{ fe("marketable_securities", bs.fiscal_year) }} | ${{ n(bs.marketable_securities) }}M |
| Total liquid cash{{ fe("total_liquid_cash", bs.fiscal_year) }} | ${{ n(bs.total_liquid_cash) }}M |
| Total debt{{ fe("total_debt", bs.fiscal_year) }} | ${{ n(bs.total_debt) }}M |
| Net debt (negative = net cash){{ fe("net_debt", bs.fiscal_year) }} | ${{ n(bs.net_debt) }}M |
| Stockholders' equity{{ fe("stockholders_equity", bs.fiscal_year) }} | ${{ n(bs.stockholders_equity) }}M |
| Valuation share count{{ fe("valuation_shares_outstanding", bs.fiscal_year) }} | {{ n(bs.valuation_shares_outstanding) }}M ({{ bs.share_count_source }}) |
| Current ratio{{ fe("current_ratio", bs.fiscal_year) }} | {{ n(sv.current_ratio, "{:.2f}x") }} |
| EBITDA{{ fe("ebitda", bs.fiscal_year) }} | ${{ n(sv.ebitda) }}M |
| Net debt / EBITDA{{ fe("net_debt_to_ebitda", bs.fiscal_year) }} | {{ n(sv.net_debt_to_ebitda, "{:.2f}x") }} |
| Debt / equity{{ fe("total_debt_to_equity", bs.fiscal_year) }} | {{ n(sv.total_debt_to_equity, "{:.2f}x") }} |
| Effective tax rate{{ fe("effective_tax_rate_pct", bs.fiscal_year) }} | {{ n(pr.effective_tax_rate_pct, "{:.1f}%") }} ({{ pr.tax_rate_source }}) |
| ROIC ({{ pr.capital_basis }} capital, net of liquid cash){{ fe("roic_pct", bs.fiscal_year) }} | {{ n(pr.roic_pct, "{:.1f}%") }} |
| ROIC ({{ pr.capital_basis }} gross debt + equity){{ fe("roic_on_gross_capital_pct", bs.fiscal_year) }} | {{ n(pr.roic_on_gross_capital_pct, "{:.1f}%") }} |
| ROE ({{ pr.capital_basis }} equity){{ fe("roe_pct", bs.fiscal_year) }} | {{ n(pr.roe_pct, "{:.1f}%") }} |
{% endmacro %}

{% macro table_f(fa) %}{% if fa.forensic_findings %}
| Severity | Code | FY | Finding |
| :--- | :--- | :---: | :--- |
{% for f in fa.forensic_findings %}
| {{ f.severity | upper }} | {{ f.code }} | {{ f.fiscal_year or "—" }} | {{ f.message }} |
{% endfor %}
{% else %}
No forensic findings triggered by the deterministic screens.
{% endif %}{% endmacro %}

{% macro data_quality_line(fa) %}{% set dq = fa.data_quality %}{{ dq.identity_checks | selectattr("status", "equalto", "passed") | list | length }}/{{ dq.identity_checks | length }} accounting identity checks passed{% if dq.missing_fields %}; missing: {{ dq.missing_fields | join(', ') }}{% endif %}{% if dq.reconciliation_log %}; reconciliation: {{ dq.reconciliation_log | join(' ') }}{% endif %}{% endmacro %}
