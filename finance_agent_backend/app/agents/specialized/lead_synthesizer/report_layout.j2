{# Route-specific report skeleton. `p` holds the (verified) prose fields; all tables come from the artifacts. #}
{% import "report_blocks.j2" as b %}
{% import "audit_tables.j2" as t %}
{% set title_suffix = company_name ~ " (" ~ ticker ~ ")" %}
{% set horizon = (forecast.forecast_horizon_years ~ "-Year") if forecast else "Multi-Year" %}
{% macro prose(text) %}{% if text %}{{ text }}

{% endif %}{% endmacro %}
{% macro provenance_note() %}{% if year_substituted %}
> ⚠️ **Filing Provenance Note**: Requested fiscal year unavailable in database catalog; substituted with latest audited filing (FY{{ fiscal_year }}).
