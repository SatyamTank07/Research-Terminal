{# Code-assembled report blocks. Every number here comes verbatim from an agent artifact; the LLM writes prose only. #}
{% import "audit_tables.j2" as t %}

{% macro money(v, f="{:,.1f}") %}{{ ("$" ~ f.format(v) ~ "M") if v is not none else "N/A" }}{% endmacro %}
{% macro pct(v, f="{:.2f}%") %}{{ f.format(v) if v is not none else "N/A" }}{% endmacro %}
{% macro per_share(v) %}{{ ("$" ~ "{:,.2f}".format(v)) if v is not none else "N/A" }}{% endmacro %}

{% macro unavailable(what, notes) %}
_{{ what }} is unavailable for this report.{% for note in notes %} {{ note }}{% endfor %}_
{% endmacro %}

{% macro dashboard(val, fc) %}
{% set w = val.wacc_audit %}
| Metric | Value |
| :--- | ---: |
| **Base-Case DCF Fair Value / Share** | **{{ per_share(val.implied_fair_value_per_share) }}** |
{% if val.bear_fair_value is not none and val.bull_fair_value is not none %}
| Bear / Bull Fair Value | {{ per_share(val.bear_fair_value) }} / {{ per_share(val.bull_fair_value) }} |
| Probability-Weighted Fair Value | {{ per_share(val.probability_weighted_fair_value) }} |
{% endif %}
| Current Share Price | {{ per_share(val.current_share_price) }}{% if val.current_share_price is not none %} ({{ val.data_quality.share_price_source }}){% endif %} |
| Base-Case Upside / Downside | {{ pct(val.upside_downside_pct, "{:+.1f}%") }} |
| Valuation Stance | {{ val.valuation_stance or "Not stated (no market price)" }} |
{% if val.market_implied_growth_pct is not none %}
| Market-Implied Revenue Growth (reverse DCF) | {{ pct(val.market_implied_growth_pct, "{:.1f}%") }} |
{% endif %}
| Discount Rate | {{ pct(w.wacc_pct) }} ({{ "user override" if w.wacc_source == "user_override" else "CAPM WACC" }}) |
{% if val.market_implied_wacc_pct is not none %}
| Market-Implied Discount Rate (at modeled cash flows) | {{ pct(val.market_implied_wacc_pct) }} |
{% endif %}
| Terminal Growth | {{ pct(val.terminal_growth_rate * 100, "{:.1f}%") }} |
| Terminal Tax Rate (marginal) | {{ pct(val.terminal_tax_rate_pct, "{:.1f}%") }} |
| Terminal Value % of EV | {{ pct(val.terminal_value_pct_of_ev, "{:.1f}%") }} |
| Enterprise Value | {{ money(val.enterprise_value) }} |
| Net Debt (negative = net cash) | {{ money(val.net_debt) }} |
| Equity Value (as of {{ val.valuation_date }}) | {{ money(val.equity_value) }} |
| Valuation Shares | {{ "{:,.1f}".format(val.diluted_shares) }}M |
{% if fc %}
| Forecast | {{ fc.forecast_horizon_years }}-year explicit horizon, {{ pct(fc.revenue_cagr_pct, "{:.1f}%") }} revenue CAGR ({{ fc.guidance_source | replace("_", " ") }}) |
{% endif %}
{% endmacro %}

